API_PORT=3100
DATABASE_URL=postgresql://realplay:realplay@localhost:5433/realplay_test
REDIS_URL=redis://localhost:6380/1
FINALIZATION_GRACE_MS=1000
# Looser than production's 1s, so a loaded machine can't time out a live board
# update and leave a test reading an empty board.
REDIS_COMMAND_TIMEOUT_MS=5000
