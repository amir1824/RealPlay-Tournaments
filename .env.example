# Copy to .env and adjust as needed.
# Postgres and Redis ports are non-default (5433 / 6380) to avoid clashing
# with services that may already be running locally.

API_PORT=3000

DATABASE_URL=postgresql://realplay:realplay@localhost:5433/realplay

REDIS_URL=redis://localhost:6380/0

# Grace period (ms) added after tournament.endsAt before the finalization
# job is allowed to run — absorbs clock skew and brief ingestion delays for
# bets whose event time lands right at the boundary. See README > Tradeoffs.
FINALIZATION_GRACE_MS=30000

# How long a Redis command may take before it fails, so an unreachable Redis
# is a fast error rather than a hung request.
REDIS_COMMAND_TIMEOUT_MS=1000

# Serve Swagger UI at /docs. Off by default; keep it off in production.
OPENAPI_ENABLED=true
