{
  "name": "realplay-tournaments",
  "version": "1.0.0",
  "private": true,
  "description": "Tournaments service: bet ingestion, live Redis leaderboard, BullMQ-driven finalization.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build api && nest build workers",
    "dev": "concurrently -n api,workers -c blue,magenta \"pnpm dev:api\" \"pnpm dev:workers\"",
    "dev:api": "dotenv -e .env -- nest start api --watch",
    "dev:workers": "dotenv -e .env -- nest start workers --watch",
    "start:api": "dotenv -e .env -- node dist/apps/api/main.js",
    "start:workers": "dotenv -e .env -- node dist/apps/workers/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e .env.test -- jest --runInBand -c test/jest-integration.json",
    "test:watch": "dotenv -e .env.test -- jest --runInBand -c test/jest-integration.json --watch",
    "format": "prettier --write \"{apps,libs,test}/**/*.ts\"",
    "docker:up": "docker compose --profile app up --build -d",
    "docker:down": "docker compose --profile app down"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "concurrently": "^9.1.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
